# Usage: cmake -DOUT=header.h -DLIST=list.txt -P embed_spv.cmake   (list: one "name=path" per line)
file(WRITE ${OUT} "// Generated: embedded SPIR-V shaders\n#pragma once\n#include <cstddef>\n\n")
set(table "")
file(STRINGS ${LIST} entries)
foreach(entry ${entries})
    string(REPLACE "=" ";" parts ${entry})
    list(GET parts 0 name)
    list(GET parts 1 path)
    file(READ ${path} hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(APPEND ${OUT} "static const unsigned char kSpv_${name}[] = {${bytes}};\n")
    string(APPEND table "    {\"${name}\", kSpv_${name}, sizeof(kSpv_${name})},\n")
endforeach()
file(APPEND ${OUT} "\nstruct EmbeddedShader { const char* name; const unsigned char* data; size_t size; };\n")
file(APPEND ${OUT} "static const EmbeddedShader kShaders[] = {\n${table}};\n")
