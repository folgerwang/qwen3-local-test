// Per (token, head): rmsnorm(1+w) over head_dim 256, then partial RoPE on the first rope_dim dims.
// Query heads (y < n_heads) read from the interleaved [query|gate] projection and write to q.
// Key heads write the K cache at position pos+t and also copy V into the V cache.
#version 460
#include "common.glsl"

layout(local_size_x = 256) in;
#define D 256
layout(push_constant) uniform PC {
    uint64_t qg, k, v, q_out, kcache, vcache, qn, kn, rope;  // rope: [pos][rope_dim/2] of (cos, sin)
    uint pos, n_heads, n_kv, rope_dim;
    float eps;
} pc;

shared float sh[D];
shared float red[8];

void main() {
    const uint t = gl_WorkGroupID.x, hh = gl_WorkGroupID.y, d = gl_LocalInvocationID.x;
    const bool is_q = hh < pc.n_heads;
    const uint h = is_q ? hh : hh - pc.n_heads;
    const float x = is_q ? F32(pc.qg).v[(t * pc.n_heads + h) * 2u * D + d] : F32(pc.k).v[(t * pc.n_kv + h) * D + d];
    const float ss = subgroupAdd(x * x);
    if (gl_SubgroupInvocationID == 0u) red[gl_SubgroupID] = ss;
    barrier();
    float tot = 0.0;
    for (uint i = 0; i < gl_NumSubgroups; i++) tot += red[i];
    const float w = F32(is_q ? pc.qn : pc.kn).v[d];
    float y = x * inversesqrt(tot / float(D) + pc.eps) * (1.0 + w);
    sh[d] = y;
    barrier();
    const uint p = pc.pos + t, half_ = pc.rope_dim / 2u;
    if (d < pc.rope_dim) {
        const uint i = d % half_;
        F32 rp = F32(pc.rope + uint64_t(p) * pc.rope_dim * 4u);
        const float c = rp.v[2u * i], s = rp.v[2u * i + 1u];
        y = d < half_ ? sh[d] * c - sh[d + half_] * s : sh[d] * c + sh[i] * s;
    }
    if (is_q) {
        F32(pc.q_out).v[(t * pc.n_heads + h) * D + d] = y;
    } else {
        const uint ci = (p * pc.n_kv + h) * D + d;
        F32(pc.kcache).v[ci] = y;
        F32(pc.vcache).v[ci] = F32(pc.v).v[(t * pc.n_kv + h) * D + d];
    }
}
