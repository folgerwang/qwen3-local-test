// Tensor-core GEMM (VK_KHR_cooperative_matrix, f16 x f16 -> f32) for many tokens. Same interface and tiling
// as gemm_fp8 (64 weight rows x 64 tokens per workgroup), so the host just picks this pipeline when the
// device supports it.
//
// FP8 weights are turned into fp16 bit patterns by re-biasing (value * 2^-8, exact for all e4m3 values).
// Activations are split into hi + lo fp16 parts and multiplied twice, which keeps ~fp32 accuracy; the
// extra tensor-core work is cheap because these GEMMs are bound by weight reads.
// A 64-row tile lies inside one 128x128 scale block, so the block scale is a single scalar per 128-wide
// K block: raw products are accumulated per K block and scaled once.
#version 460
#include "common.glsl"
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;
#define BM 64
#define BN 64
#define BK 32
#define LDA (BK + 8)
#define LDC (BM + 4)

#ifdef EXPERT
struct Entry { uint64_t base; uint start, count; };
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer Table { Entry e[]; };
layout(push_constant) uniform PC {
    uint64_t table, toks, x, y;
    uint woff1, soff1, woff2, soff2, rows, cols, x_stride, y_stride, x_mode;
} pc;
#else
layout(push_constant) uniform PC {
    uint64_t w1, s1, w2, s2, x, y;
    uint rows, cols, n, x_stride, y_stride;
} pc;
#endif

shared float16_t Ws[BM * LDA];
#ifdef SWIGLU
shared float16_t Ws2[BM * LDA];
#endif
shared float16_t Xs[BN * LDA], Xl[BN * LDA];  // activations as hi + lo fp16 pair (~fp32 precision)
shared float Cs[BN * LDC];

#define MatA coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define MatB coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define MatC coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

// 8 fp8 bytes -> 8 fp16 values (times 2^-8) written to dst[0..7]
void store_fp8x8(uvec2 w, uint base, bool second) {
    [[unroll]] for (uint h = 0; h < 2u; h++) {
        const uint v = w[h];
        const uint e = v & 0x00FF00FFu, o = (v >> 8) & 0x00FF00FFu;
        const f16vec2 a = unpackFloat2x16(((e & 0x00800080u) << 8) | ((e & 0x007F007Fu) << 7));  // bytes 0, 2
        const f16vec2 b = unpackFloat2x16(((o & 0x00800080u) << 8) | ((o & 0x007F007Fu) << 7));  // bytes 1, 3
        const uint i = base + h * 4u;
#ifdef SWIGLU
        if (second) { Ws2[i] = a.x; Ws2[i + 1u] = b.x; Ws2[i + 2u] = a.y; Ws2[i + 3u] = b.y; continue; }
#endif
        Ws[i] = a.x; Ws[i + 1u] = b.x; Ws[i + 2u] = a.y; Ws[i + 3u] = b.y;
    }
}

// Q4: 8 4-bit weights of one word, scaled (per row and 128-input group) -> 8 fp16 values at dst[0..7]
void store_q4x8(uint w, float sc, uint base, bool second) {
    vec4 lo, hi;
    q4x8(w, lo, hi);
    lo *= sc;
    hi *= sc;
    [[unroll]] for (uint j = 0; j < 4u; j++) {
#ifdef SWIGLU
        if (second) { Ws2[base + j] = float16_t(lo[j]); Ws2[base + 4u + j] = float16_t(hi[j]); continue; }
#endif
        Ws[base + j] = float16_t(lo[j]);
        Ws[base + 4u + j] = float16_t(hi[j]);
    }
}

void main() {
    const uint tid = gl_LocalInvocationID.x, sg = gl_SubgroupID;
    const uint r0 = gl_WorkGroupID.x * BM;
    const uint cols = pc.cols, nblk = cols / 128u;
#ifdef EXPERT
    const Entry en = Table(pc.table).e[gl_WorkGroupID.y];
    const uint ntok = en.count, out0 = en.start;
    const uint64_t w1 = en.base + pc.woff1, s1 = en.base + pc.soff1, w2 = en.base + pc.woff2, s2 = en.base + pc.soff2;
#else
    const uint t0 = gl_WorkGroupID.y * BN;
    const uint ntok = min(BN, pc.n - t0), out0 = t0;
    const uint64_t w1 = pc.w1, s1 = pc.s1, w2 = pc.w2, s2 = pc.s2;
#endif
    const uint lr = tid / 4u, lk = (tid % 4u) * 8u;
    const bool tok_ok = lr < ntok;
#ifdef EXPERT
    const uint xrow = tok_ok ? (pc.x_mode == 0u ? U32(pc.toks).v[en.start + lr] : en.start + lr) : 0u;
#else
    const uint xrow = t0 + lr;
#endif
    F4 xs = F4(pc.x + uint64_t(xrow) * pc.x_stride * 4u);
    const uint wrow = r0 + lr;

    // subgroup sg owns rows rb*16.. and token blocks tb0, tb0+1 of the 64x64 output tile
    const uint rb = sg / 2u, tb0 = (sg % 2u) * 2u;
    MatC acc[2], part[2];
#ifdef SWIGLU
    MatC acc2[2], part2[2];
#endif
    [[unroll]] for (uint j = 0; j < 2u; j++) {
        acc[j] = MatC(0.0); part[j] = MatC(0.0);
#ifdef SWIGLU
        acc2[j] = MatC(0.0); part2[j] = MatC(0.0);
#endif
    }

    for (uint k0 = 0; k0 < cols; k0 += BK) {
        const uint widx = (wrow * cols + k0 + lk) / 8u;
#ifdef Q4
        const uint si4 = wrow * nblk + (k0 + lk) / 128u;
        store_q4x8(U32(w1).v[widx], f16_at(s1, si4), lr * LDA + lk, false);
#ifdef SWIGLU
        store_q4x8(U32(w2).v[widx], f16_at(s2, si4), lr * LDA + lk, true);
#endif
#else
        store_fp8x8(U2(w1).v[widx], lr * LDA + lk, false);
#ifdef SWIGLU
        store_fp8x8(U2(w2).v[widx], lr * LDA + lk, true);
#endif
#endif
        vec4 x0 = vec4(0.0), x1 = vec4(0.0);
        if (tok_ok) { x0 = xs.v[(k0 + lk) / 4u]; x1 = xs.v[(k0 + lk) / 4u + 1u]; }
        [[unroll]] for (uint j = 0; j < 4u; j++) {
            // hi = x with the low 13 mantissa bits cleared (exact in fp16), lo = x - hi (exact in fp32).
            // Done with bit masks: a float->half->float round trip may be folded away by the driver.
            const float h0 = uintBitsToFloat(floatBitsToUint(x0[j]) & 0xFFFFE000u);
            const float h1 = uintBitsToFloat(floatBitsToUint(x1[j]) & 0xFFFFE000u);
            Xs[lr * LDA + lk + j] = float16_t(h0);
            Xs[lr * LDA + lk + 4u + j] = float16_t(h1);
            Xl[lr * LDA + lk + j] = float16_t(x0[j] - h0);
            Xl[lr * LDA + lk + 4u + j] = float16_t(x1[j] - h1);
        }
        barrier();
        [[unroll]] for (uint kk = 0; kk < BK; kk += 16u) {
            MatA a;
            coopMatLoad(a, Ws, rb * 16u * LDA + kk, LDA, gl_CooperativeMatrixLayoutRowMajor);
#ifdef SWIGLU
            MatA a2;
            coopMatLoad(a2, Ws2, rb * 16u * LDA + kk, LDA, gl_CooperativeMatrixLayoutRowMajor);
#endif
            [[unroll]] for (uint j = 0; j < 2u; j++) {
                MatB b, bl;  // B[k][t] = Xs[t * LDA + k]
                coopMatLoad(b, Xs, (tb0 + j) * 16u * LDA + kk, LDA, gl_CooperativeMatrixLayoutColumnMajor);
                coopMatLoad(bl, Xl, (tb0 + j) * 16u * LDA + kk, LDA, gl_CooperativeMatrixLayoutColumnMajor);
                part[j] = coopMatMulAdd(a, b, part[j]);
                part[j] = coopMatMulAdd(a, bl, part[j]);
#ifdef SWIGLU
                part2[j] = coopMatMulAdd(a2, b, part2[j]);
                part2[j] = coopMatMulAdd(a2, bl, part2[j]);
#endif
            }
        }
        barrier();
#ifdef Q4
        // weights were scaled while loading: no per-block scaling
        [[unroll]] for (uint j = 0; j < 2u; j++) {
            acc[j] += part[j];
            part[j] = MatC(0.0);
#ifdef SWIGLU
            acc2[j] += part2[j];
            part2[j] = MatC(0.0);
#endif
        }
#else
        if ((k0 + BK) % 128u == 0u) {  // end of a scale block: acc += scale * part
            const uint si = (r0 / 128u) * nblk + k0 / 128u;
            const float sc = bf16_at(s1, si) * 256.0;
#ifdef SWIGLU
            const float sc2 = bf16_at(s2, si) * 256.0;
#endif
            [[unroll]] for (uint j = 0; j < 2u; j++) {
                acc[j] += part[j] * MatC(sc);
                part[j] = MatC(0.0);
#ifdef SWIGLU
                acc2[j] += part2[j] * MatC(sc2);
                part2[j] = MatC(0.0);
#endif
            }
        }
#endif
    }
    [[unroll]] for (uint j = 0; j < 2u; j++) {
#ifdef SWIGLU
        for (int i = 0; i < acc[j].length(); i++) acc[j][i] = silu(acc[j][i]) * acc2[j][i];
#endif
        coopMatStore(acc[j], Cs, (tb0 + j) * 16u * LDC + rb * 16u, LDC, gl_CooperativeMatrixLayoutColumnMajor);
    }
    barrier();
    for (uint i = tid; i < BM * BN; i += 256u) {
        const uint t = i / BM, r = i % BM;
        if (t < ntok) F32(pc.y + uint64_t(out0 + t) * pc.y_stride * 4u).v[r0 + r] = Cs[t * LDC + r];
    }
}
